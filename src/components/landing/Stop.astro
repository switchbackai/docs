---
// One stop on the Route. The last stop is the destination: a check, not a number.
interface Props {
  n?: number;
  title: string;
  destination?: boolean;
}
const { n, title, destination = false } = Astro.props;
---

<li class="stop">
  <span class:list={['node', { dest: destination }]} aria-hidden="true">
    {
      destination ? (
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
      ) : (
        n
      )
    }
  </span>
  <div class="text">
    <h3>{title}</h3>
    <slot name="text" />
  </div>
  <slot />
</li>

<style>
  .stop {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .node {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--signal);
    color: var(--text-on-signal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    position: relative;
    z-index: 1;
    border: 3px solid var(--surface-base);
    box-sizing: content-box;
  }
  .node.dest {
    background: var(--surface-raised);
    border-color: var(--signal);
    box-shadow: 0 0 0 5px var(--signal-surface);
    color: var(--signal-text);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  h3 {
    margin: 0;
    font-size: 20px;
    line-height: 27px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .text :global(p) {
    margin: 0;
    color: var(--text-secondary);
  }
  .stop :global(.expressive-code) {
    margin: 0;
  }
</style>
