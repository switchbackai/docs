---
// The actions above the title of a page: copy its Markdown, open its Markdown,
// and, on a page with an `agent:` prompt, copy that prompt and the Markdown.
interface Props {
  /** The route of the page's Markdown copy, as /set-up/log-in.md. */
  markdown: string;
  agent?: string | undefined;
}
const { markdown, agent } = Astro.props;
---

<div class="page-actions">
  <button type="button" class="page-action" data-markdown={markdown}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
    <span class="label"><span data-label>Copy page</span><span class="sizer" aria-hidden="true">Copy page</span><span class="sizer" aria-hidden="true">Copy failed</span></span>
  </button>
  <a class="page-action" href={markdown}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3l-9 9M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"></path></svg>
    View as Markdown
  </a>
  {
    agent && (
      <button type="button" class="page-action agent" data-markdown={markdown} data-prompt={agent}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 17 6-6-6-6M12 19h8"></path></svg>
        <span class="label"><span data-label>Copy for your agent</span><span class="sizer" aria-hidden="true">Copy for your agent</span></span>
      </button>
    )
  }
  <span class="sr-only" role="status" aria-live="polite" data-status></span>
</div>

<script>
  // Copy the Markdown copy of the page, after the prompt when there is one, and
  // say on the button whether it worked.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.page-action[data-markdown]')) {
    const label = button.querySelector<HTMLElement>('[data-label]')!;
    const status = button.parentElement!.querySelector<HTMLElement>('[data-status]')!;
    const idle = label.textContent;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      let said = 'Copied';
      try {
        const response = await fetch(button.dataset.markdown!);
        if (!response.ok) throw new Error(String(response.status));
        const page = await response.text();
        const prompt = button.dataset.prompt;
        await navigator.clipboard.writeText(prompt ? `${prompt}\n\n${page}` : page);
      } catch {
        said = 'Copy failed';
      }
      label.textContent = status.textContent = said;
      clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = idle), 2000);
    });
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 14px;
  }
  .page-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }
  .page-action:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .page-action:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
  .page-action.agent {
    color: var(--signal-text);
  }
  /* The label and its longest texts share one cell, so "Copied" does not move the buttons. */
  .label {
    display: inline-grid;
    justify-items: start;
  }
  .label > * {
    grid-area: 1 / 1;
  }
  .sizer {
    visibility: hidden;
  }
</style>
