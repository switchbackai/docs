---
// The horizontal lockup: the mark and the lowercase wordmark in Inter 800
// (design system, Lockups).
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="switchbak docs home">
  <svg class="mark" viewBox="0 0 120 120" aria-hidden="true">
    <path
      d="M80.92,31.18 L43.08,53.54 L80.92,72.46 L43.08,94.82"
      fill="none"
      stroke="var(--sb-mark)"
      stroke-width="15"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="wordmark" translate="no">switchbak</span>
  <span class="tag">docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .mark {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
  }
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.03em;
  }
  .tag {
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
    color: var(--text-muted);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
  }
</style>
